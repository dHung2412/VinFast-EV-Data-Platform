{
  "dataset": "telemetry",
  "version": "2.0.0",
  "description": "Vehicle telemetry events — physical realism engine v2",
  "grain": "1 row per vehicle per event (10s driving / 30s charging / 15min heartbeat)",
  "primary_keys": ["vehicle_id", "event_timestamp"],
  "cadence": "daily batch, hive-partitioned by batch date (year=/month=/day=)",
  "pii_fields": ["latitude", "longitude"],
  "retention_days": 730,
  "fields": [
    {"name": "vehicle_id", "type": "string", "required": true, "pattern": "^VFS-[0-9]{5}$"},
    {"name": "event_timestamp", "type": "datetime", "required": true, "format": "date-time"},
    {"name": "model", "type": "string", "required": true, "enum": ["VF 3", "VF 5", "VF e34", "VF 6", "VF 7", "VF 8", "VF 9", "VF Amio S", "VF Evo Lite S", "VF Flazz S"]},
    {"name": "type", "type": "string", "required": true, "enum": ["car", "motorbike"]},
    {"name": "battery_soc_pct", "type": "number", "required": true, "min": 0, "max": 100},
    {"name": "battery_soh_pct", "type": "number", "required": true, "min": 80, "max": 100},
    {"name": "battery_temp_c", "type": "number", "required": true, "min": -20, "max": 90},
    {"name": "battery_temp_avg_c", "type": "number", "required": true, "min": -20, "max": 90},
    {"name": "battery_temp_max_c", "type": "number", "required": true, "min": -20, "max": 95},
    {"name": "charging_status", "type": "string", "required": true, "enum": ["disconnected", "charging_ac", "charging_dc_fast", "fully_charged"]},
    {"name": "speed_kmh", "type": "number", "required": true, "min": 0, "max": 185},
    {"name": "odometer_km", "type": "number", "required": true, "min": 0},
    {"name": "motor_rpm", "type": "integer", "required": true, "min": 0, "max": 15000},
    {"name": "motor_temp_c", "type": "number", "required": true, "min": -20, "max": 180},
    {"name": "inverter_temp_c", "type": "number", "required": true, "min": -20, "max": 150},
    {"name": "gear_mode", "type": "string", "required": true, "enum": ["P", "D", "R", "N", "B"]},
    {"name": "latitude", "type": "number", "required": true, "min": 8.0, "max": 24.0},
    {"name": "longitude", "type": "number", "required": true, "min": 102.0, "max": 110.0},
    {"name": "acceleration_x", "type": "number", "required": true, "min": -50, "max": 50},
    {"name": "acceleration_y", "type": "number", "required": true, "min": -30, "max": 30},
    {"name": "acceleration_z", "type": "number", "required": true, "min": 5, "max": 15},
    {"name": "lock_status", "type": "string", "required": true, "enum": ["locked", "unlocked"]},
    {"name": "cabin_temp_c", "type": "number", "required": false, "nullable": true, "min": -10, "max": 60},
    {"name": "hvac_power_kw", "type": "number", "required": true, "min": 0, "max": 10},
    {"name": "airbag_deployed", "type": "boolean", "required": true},
    {"name": "tire_pressure_fl_bar", "type": "number", "required": true, "min": 0.5, "max": 5.0},
    {"name": "tire_pressure_fr_bar", "type": "number", "required": true, "min": 0.5, "max": 5.0},
    {"name": "tire_pressure_rl_bar", "type": "number", "required": false, "nullable": true, "min": 0.5, "max": 5.0},
    {"name": "tire_pressure_rr_bar", "type": "number", "required": false, "nullable": true, "min": 0.5, "max": 5.0},
    {"name": "ambient_temp_c", "type": "number", "required": true, "min": -10, "max": 50},
    {"name": "is_charging", "type": "boolean", "required": true},
    {"name": "charging_power_kw", "type": "number", "required": true, "min": 0, "max": 400},
    {"name": "ignition_on", "type": "boolean", "required": true}
  ],
  "quality_assertions": [
    {"rule": "battery_soc_pct in [0, 100]", "columns": ["battery_soc_pct"]},
    {"rule": "odometer_km non-decreasing per vehicle ordered by event_timestamp", "columns": ["odometer_km"]},
    {"rule": "is_charging XOR is_driving (is_driving = speed_kmh>2 AND NOT is_charging; cannot be both true)", "columns": ["is_charging", "speed_kmh"]},
    {"rule": "charging_status consistent with is_charging (is_charging=true -> charging_status in [charging_ac, charging_dc_fast, fully_charged]; is_charging=false -> disconnected)", "columns": ["charging_status", "is_charging"]},
    {"rule": "motor_rpm consistent with speed (speed=0 -> rpm=0; speed>0 -> rpm>0 for car)", "columns": ["motor_rpm", "speed_kmh"]},
    {"rule": "gear_mode consistent with speed and charging (is_charging -> P; speed>0 -> D/B)", "columns": ["gear_mode", "speed_kmh", "is_charging"]}
  ]
}
